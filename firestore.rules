rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every request must carry a Firebase Auth token (the app signs in
    // anonymously on startup). Anonymous users are indistinguishable by
    // UID, so per-user access control still lives in app logic, but the
    // database is no longer open to the public internet.
    //
    // Collections are enumerated explicitly: a recursive `{document=**}`
    // wildcard would overlap the deny blocks below and re-grant access
    // (Firestore grants when ANY matching rule allows). Keep the list in
    // sync with `COLLECTIONS` in functions/index.js.
    match /users/{docId} { allow read, write: if request.auth != null; }
    match /stations/{docId} { allow read, write: if request.auth != null; }
    match /shifts/{docId} { allow read, write: if request.auth != null; }
    match /attendance/{docId} { allow read, write: if request.auth != null; }
    match /faults/{docId} { allow read, write: if request.auth != null; }
    match /fault_updates/{docId} { allow read, write: if request.auth != null; }
    match /outside_broadcasts/{docId} { allow read, write: if request.auth != null; }
    match /tasks/{docId} { allow read, write: if request.auth != null; }
    match /handovers/{docId} { allow read, write: if request.auth != null; }
    match /notifications/{docId} { allow read, write: if request.auth != null; }
    match /reports/{docId} { allow read, write: if request.auth != null; }
    match /jobs/{docId} { allow read, write: if request.auth != null; }
    match /equipment/{docId} { allow read, write: if request.auth != null; }
    match /transactions/{docId} { allow read, write: if request.auth != null; }
    match /daily_rewards/{docId} { allow read, write: if request.auth != null; }
    match /broadcast_status/{docId} { allow read, write: if request.auth != null; }
    match /announcements/{docId} { allow read, write: if request.auth != null; }
    match /audit_logs/{docId} { allow read, write: if request.auth != null; }
    match /attachments/{docId} { allow read, write: if request.auth != null; }
    match /auth_uids/{docId} { allow read, write: if request.auth != null; }
    match /sessions/{docId} { allow read, write: if request.auth != null; }
    match /duty_acknowledgements/{docId} { allow read, write: if request.auth != null; }

    // PINs live server-side only: the client verifies through the rate-limited
    // `verifyPin` Cloud Function (admin SDK), which bypasses these rules.
    match /user_credentials/{docId} { allow read, write: if false; }
    match /pin_attempts/{docId} { allow read, write: if false; }
  }
}
